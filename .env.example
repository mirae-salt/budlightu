# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (production)
ANTHROPIC_API_KEY=

# Gemini (free tier — dev/local e2e OCR test fallback only, used when ANTHROPIC_API_KEY is empty)
GEMINI_API_KEY=

# Resend (free tier — invite/notification emails, 100/day, no card needed)
# Sign up at resend.com → API Keys → Create
RESEND_API_KEY=

# Microsoft Graph (delegated app for Outlook + SharePoint) — optional upgrade;
# when all three are set, lib/send-email.ts uses Graph instead of Resend.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_MAILBOX=accounts.payable.dryrun@ilovesalt.com

# AP send routing (app/api/admin/send-ap) — defaults shown, override if needed
AP_EMAIL=accounts.payable@ilovesalt.com
AP_CC_EMAILS=Jenna.Greenspoon@ilovesalt.com,robin.graham@ilovesalt.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
