# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (receipt OCR vision model) — sign up at openrouter.ai, create a key, top up credits
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview

# Email — Resend is the primary provider (requires domain verification)
RESEND_API_KEY=

# Gmail SMTP — disabled, kept for reference
# GMAIL_USER=budlightu.portal@gmail.com
# GMAIL_APP_PASSWORD=
# GMAIL_FROM_NAME=Bud Light U

# AP send routing (app/api/admin/send-ap) — defaults shown, override if needed
AP_EMAIL=accounts.payable@ilovesalt.com
AP_CC_EMAILS=Jenna.Greenspoon@ilovesalt.com,robin.graham@ilovesalt.com

# Where replies go. budlightu.com has NO MX record -- it is send-only -- so a reply to
# the From address bounces. The invite email tells students to "reply to this email",
# and AP may well reply to an invoice, so without this those replies vanish.
# Leave blank and no Reply-To header is set at all, which is better than pointing at a
# mailbox that does not exist.
REPLY_TO_EMAIL=robin.graham@ilovesalt.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Explicit opt-in required (in addition to NODE_ENV=development) to skip auth
# checks in middleware.ts and the TEST_RECEIPT_SHA bypass in upload/route.ts.
# Never set this in Vercel/production env vars.
ALLOW_DEV_AUTH_BYPASS=true
