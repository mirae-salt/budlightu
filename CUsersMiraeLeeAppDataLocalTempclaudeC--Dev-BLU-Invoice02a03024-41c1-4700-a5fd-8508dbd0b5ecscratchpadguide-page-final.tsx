          <thead><tr><th>Check</th><th>What it means</th><th style={{ width: 80 }}>Priority</th></tr></thead>
          <tbody>
            <FlagRow name="Not a real receipt" desc="The image is something else — a bus ticket, Uber ride, bank notification, pizza order, etc." severity="High" />
